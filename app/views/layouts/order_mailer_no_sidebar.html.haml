!!! Strict
%html
  %head
    %meta{'http-equiv'=>'Content-Type', :content=>"text/html; charset=utf-8"}
    %meta{:name=>"viewport", :content=>"width=device-width"}
    %title
      <%= yield :email_title %>
    =render 'foundation_email_css'

  %body
    <!-- <style> -->
    %table.body{:data-made-with-foundation=>""}
      %tr
        %td.float-center{:align=>"center",:valign=>"top"}
          %center{'data-parsed'=>''}
            %table.spacer.float-center
              %tbody
                %tr
                  %td{:height=>"16px", :style=>"font-size:16px;line-height:16px;"} &#xA0;

            %table.wrapper.header.float-center{:bgcolor=>"#f3f3f3", :align=>"center"}
              %tr
                %td.wrapper-inner
                  %table.container{:align=>"center"}
                    %tbody
                      %tr
                        %td
                          %table.grid-x.grid-padding-x.collapse
                            %tbody
                              %tr
                                -# A show presented by a visiting company is co-branded: their logo
                                -# first, the house's second. Everything else is the house alone.
                                - if @order.theater.nil? || @order.theater.producing? || !@order.theater.logo.attached?
                                  %th.small-12.cell.first{:valign=>'middle'}
                                    %table
                                      %tr
                                        %td.vhcenter
                                          = render 'house_logo'
                                - else
                                  %th.small-6.large-6.cell.first{:valign=>"middle"}
                                    %table
                                      %tr
                                        %td.vhcenter
                                          %img{:src=>"#{@order.theater.decorate.logo_url(Theater::MEDIUM)}"}
                                  %th.small-6.large-6.cell.last{:valign=>"middle"}
                                    %table
                                      %tr
                                        %th.vhcenter
                                          = render 'house_logo'

            %table.container.float-center{:align=>"center"}
              %tbody
                %tr
                  %td
                    %table.spacer
                      %tbody
                        %tr
                          %td{:height=>"16px", :style=>"font-size:16px;line-height:16px;"} &#xA0;
                        %tr
                          %td{:style=>"padding:0px 8px 0px 8px"}
                            %h1
                              =yield :email_title
                    %table.grid-x.grid-padding-x
                      %tbody
                        %tr
                          %th.small-12.cell.first
                            %table
                              %tr
                                %th

                                  =yield


