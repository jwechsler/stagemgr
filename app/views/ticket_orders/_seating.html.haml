<!--Creates the popup body-->
-# show_backend_classes is a render-context flag: false (default) on the public
-# order flow, passed true by admin/ticket_orders/_seating for the box office.
- show_backend_classes = local_assigns.fetch(:show_backend_classes, false)
= render partial:'/seat_assignments/ticket_class_selector', locals: {order_form: order_form, show_backend_classes: show_backend_classes}
#ticket-items{'data-line-items':'[]'}
- unavailable_data = raw '{"alwaysOn": true, "fillColor":"000000"}'
.grid-x.grid-padding-x
  .cell.small-12.medium-6
    = render partial:'/ticket_orders/ticket_line_items', locals:{order_form: order_form}
    = render partial:'/seat_assignments/non_seat_ticket_picker', locals:{order_form: order_form, show_backend_classes: show_backend_classes}
  .cell.small-12.medium-6
    <!-- Seating Map -->
    =render partial:'/admin/ticket_orders/seatmap', locals:{ticket_order:ticket_order}

= content_for :js do
  = javascript_include_tag 'seat_assignment'
  - unless order_form.object.performance_id.blank?
    :javascript
      $(document).ready(function() {
        // The popup is filtered server-side by the show_backend_classes render
        // context (web_visible only on the public flow), so we intentionally
        // skip populate_ticket_selector here — the server-rendered rows are
        // already correct for whichever context rendered this partial.
        get_ticket_classes();
        populate_ticket_order();
      });
