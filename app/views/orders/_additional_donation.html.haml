.grid-x.grid-padding-x
  - t = order_form.object.performance.production.theater
  - unless t.is_default? || t.is_copro? || !t.accepts_donations?
    .small-12.cell
      %fieldset.panel.fieldset
        %legend
          Donate to
          = t.name
        = render 'orders/donation_appeal', text: t.donation_appeal_for, order_form: order_form,
                                           field: :additional_donation_for_other

  - if Theater.default_theater.accepts_donations || t.accepts_donations?
    .small-12.cell
      - default_text = t.blank? || t.is_default?
      %fieldset.panel.fieldset
        %legend
          - if default_text
            I wish to offer additional support
          - else
            Make a donation to
            = t.is_copro? ? t.name : Theater.default_theater.name
        :ruby
          # A co-production shows only its own appeal, never the secondary one.
          default_theater = Theater.default_theater
          appeal = t.producing? ? t.donation_appeal_for : default_theater.secondary_donation_appeal_for(company: t)
        = render 'orders/donation_appeal', text: appeal, order_form: order_form, field: :additional_donation
