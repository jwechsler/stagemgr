<%= render 'followup_title', order: @order %>
<%# Same split as standard_followup, with a welcome pitch added for a patron
    who has not been here before. Pronouns come from TheaterInfo#first_person?,
    so a house that named nobody writes as a house throughout. %>
<% personal = theater_info.first_person? %>
<% if @order.performance.production.theater.producing? %>
<p>
  <%= personal ? 'I hope' : 'We hope' %> you had a good evening and will return soon (there are a few suggestions in the sidebar on the right, but check our website for all upcoming events).
</p><p>
  <%= personal ? "I'd" : "We'd" %> like to take this opportunity to invite you back to <%= theater_info.name %>.
  There's a ton happening here, some of which are listed in the sidebar to the right, and <%= personal ? 'I hope' : 'we hope' %> you'll have a chance to check out some more.
</p>
<%= render 'core_followup', order: @order %>
<% else %>
<%= render 'followup_custom_message', order: @order, neutral_fallback: true %>
<%= render 'survey_prompt', order: @order %>
<%= render 'host_callout', order: @order, welcome_pitch: true %>
<% end %>
