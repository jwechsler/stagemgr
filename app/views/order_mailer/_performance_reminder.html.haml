- content_for :email_title do
  See you
  = Date::DAYNAMES[order.performance.performance_date.wday]
= render partial: 'presenter_identity', locals: {order: order}
- if order.attends_in_person?
  %p= render partial: 'in_person_ticket_summary', locals: {order: order, reminder: true}
- if order.includes_virtual?
  %p= render partial: 'virtual_ticket_summary', locals: {order: order, reminder: true}
- if order.attends_in_person? && !order.performance.production.allow_late_seating
  %p
    Please note, there is no late seating available for this performance.

= render partial: 'performance_info', locals: {order: order}

%p
  %i
    - unless order.performance.production.treat_as_special_event? || !order.attends_in_person?
      See you at the theater!
