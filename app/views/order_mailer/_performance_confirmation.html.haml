= content_for :email_title do
  Your tickets for
  = raw("<i>#{order.performance.production.name}#{!order.theater.is_default? ? ',</i> presented by ' + order.theater.name : '</i>'}")

%h3
  Thanks for your order!
= render partial: 'presenter_identity', locals: {order: order}
-# Admission decides the summary: in-person tickets get the box office line
-# (which carries the charge sentence) and the late-seating note, virtual
-# tickets their own line, and an order with neither just the charge line.
-# Mixed orders get both summaries.
- if order.attends_in_person?
  %p
    = render partial: 'in_person_ticket_summary', locals: {order: order}
    - unless order.performance.production.allow_late_seating?
      %b
        Please note, there is no late seating available for this
        = order.performance.production.treat_as_special_event? ? "event." : "performance."
- if order.includes_virtual?
  %p= render partial: 'virtual_ticket_summary', locals: {order: order, show_charge: !order.attends_in_person?}
- unless order.attends_in_person? || order.includes_virtual?
  = render partial: 'charge_information', locals: {order: order}

= render partial: 'performance_info', locals: {order: order}
