<% content_for :email_title do %>
 <%- if @order.gift? %>
              Thanks for purchasing a <%= @membership.membership_offer.name %> for <%= @order.recipient_name %>.
  <% else %>
    Thanks so much for becoming a member at <%= theater_info.name %>.
  <% end %>
<% end %>
<%- if @order.gift? %>
    <p>
    Starting <%= @order.gift_date.to_s(:long) %>, <%= @order.gift_recipient %> will be able to to use
    member code <b><%= @membership.member_code %></b> to attend a wide variety of performances and
    productions here at <%= theater_info.name %>.  If you'd like to get a physical membership card to
    give with your gift, just contact our box office<% if theater_info.phone.present? %>
    at <%= theater_info.phone %><% end %>; if not, <%= @order.recipient_name %> can pick
    up the card along with their first reservation.</p>
<% else %>
  <p>
  <%- if @membership.active? %>
    Your <%= @membership.membership_offer.name %> is ready to use immediately. You'll be getting a permanent card
    in the mail as well as a detailed brochure about how to use it?  But hey, why wait? You can start using your
    membership today.
  <%- else %>
    Your membership is not yet active. Sometimes it takes the payment processor an hour to validate your
    subscription. In the meantime, we'll be happy to put tickets on hold for you.  Just call the box office
    with your name and member code.
  <%- end %>
  </p>
  <h4>
    Using your Membership
  </h4>
  <p align="center"><b>Your member code is <%= @membership.member_code %></b><p>

    <p>To use your membership online, just choose "Membership" instead of "Credit Card" as your payment method, and type
    in that code.  You can use your membership to reserve a single ticket to any regular performance here at
    <%= theater_info.name %>.
    You can also drop by our box office with your code get pick up your tickets in advance in person if you're in the
    neighborhood.</p>
  <%# Self-service subscription management is Stripe's hosted portal. A house
      that bills some other way has no such link, so the whole section goes
      rather than sending members to a button that does nothing. %>
  <% portal = theater_info.stripe_billing_portal_url %>
  <% if portal.present? %>
    <% portal_url = [portal, { prefilled_email: @order.address.email }.to_query].join(portal.include?('?') ? '&' : '?') %>
    <h4>Managing your membership</h4>
    <p>
      You can update your credit card information or cancel your membership after the first three months by visiting
    </p>
    <table class="button">
      <tr>
        <td>
          <table>
            <tr>
              <td>
                <center data-parsed=''>
                  <a align="center" class="float-center" href="<%= portal_url %>">Manage your subscription</a>
                </center>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
    <br/>
  <% end %>

  <h4>
    Come as often as you like
  </h4>

  <p>
    Keep in mind that your membership cannot be shared with another person.  Until our box office gets to know you, please make sure to bring a picture ID when you come to pick up tickets.
  </p>
  <p>
    <%=raw @membership.membership_offer.email_html %>
  </p>
<% end %>
<p>
  <%= render 'shared/house_thanks_line' %>
</p>
<p>
  See you at the theater!<br/>
  <%= render 'signature' %>
</p>
