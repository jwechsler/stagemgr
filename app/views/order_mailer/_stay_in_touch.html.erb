<%# The sign-off of the follow-up letter: where to follow the house, the
    mailing-list pitch, and whoever signs the mail.

    Every channel is a fact and every one is optional, so the sentence is built
    from whichever are configured rather than printing dead links. A house with
    no web presence at all still gets a sign-off. %>
<% channels = [] %>
<% channels << link_to('our website', theater_info.website_url) if theater_info.website_url.present? %>
<% channels << link_to('Facebook', theater_info.facebook_url) if theater_info.facebook_url.present? %>
<% channels << link_to('Twitter', theater_info.twitter_url) if theater_info.twitter_url.present? %>
<% channels << link_to('Instagram', theater_info.instagram_url) if theater_info.instagram_url.present? %>
<% mailing_list = mailing_list_link(order.performance.production) %>
<% personal = theater_info.first_person? %>
<table class="w410" width="410" cellpadding="0" cellspacing="0" border="0">
  <tbody>
    <tr>
      <td class="w410" width="410">
        <h5 align="left" class="article-title">
          Stay in touch
        </h5>
        <div align="left" class="article-content">
          <% if channels.any? %>
            <%# to_sentence over SafeBuffers returns a plain String; the parts are
                link_to output and literal connectors, so marking the result safe
                re-asserts what each piece already guaranteed. %>
            <p>
              You can check in on
              <%= channels.to_sentence(two_words_connector: ' or ', last_word_connector: ', or ').html_safe %>
              for current news.
            </p>
          <% end %>
          <p>
            <% if mailing_list.present? %>
              While this is <b>the last email</b> you'll get from your ticket order, there's always our
              <a href="<%= mailing_list %>">mailing list if you're afraid you'll miss us</a>.
            <% end %>
            <%= personal ? 'I hope' : 'We hope' %> you had a great time at <%= theater_info.name %>.
          </p>
          <br/>
          See you at the theater!<br/>
          <%= render 'signature' %>
        </div>
      </td>
    </tr>
    <tr><td class="w410" width="410" height="10"></td></tr>
  </tbody>
</table>
