%table
  %thead
    %tr
      %td Tag
      %td Value
  %tbody
  - current_user.allowed_tags(address_tags).each do |tag|
    %tr{ class: ('lgl-review' if tag.tag_label == AddressTag::LGL_REVIEW) }
      %td
        = tag.tag_label
        = " [#{tag.theater.name}]" unless (tag.theater.nil? || tag.theater.producing?)
      %td
        = tag.tag_value
        - if tag.tag_label == AddressTag::LGL_ID && Lgl.enabled? && can?(:lgl_sync, tag.address)
          - resync_path = lgl_sync_admin_address_path(tag.address)
          = button_to 'Re-sync with LGL', resync_path, method: :post, class: 'tiny button', form_class: 'lgl-resync'
