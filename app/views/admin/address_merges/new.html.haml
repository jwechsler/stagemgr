- content_for :title do
  Merge customers
- content_for :breadcrumbs do
  - back = { label: @constituent_id ? 'Little Green Light sync' : 'Customers', path: @cancel_path }
  = render 'shared/components/breadcrumb', items: [back, { label: 'Merge customers' }]

:ruby
  merge = @merge
  lgl_url = @constituent_id && Lgl.constituent_url(@constituent_id)
.grid-x.grid-padding-x
  - if @constituent_id
    .cell.auto
      %p LGL constituent #{lgl_constituent_id_link(@constituent_id)}
    - if lgl_url
      .cell.shrink.text-right
        = link_to 'View in LGL', lgl_url, target: '_blank', rel: 'noopener'
  - unless Lgl::ReviewList.same_person?(merge.addresses)
    .small-12.cell
      %p.callout.warning
        These customers have different first names (#{lgl_review_first_names(merge.addresses)}):
        they may be a household, not one person.
        - if @constituent_id
          Check the constituent in LGL before merging.

  .small-12.cell
    = form_tag admin_address_merge_path, method: :post, id: 'address-merge-form' do
      - merge.ids.each do |id|
        = hidden_field_tag 'ids[]', id, id: nil
      - if @constituent_id
        = hidden_field_tag :constituent_id, @constituent_id
      %table.address-merge
        %thead
          %tr
            %th
            - merge.addresses.each do |address|
              %th= address_merge_header(merge, address)
        %tbody
          - Address::ManualMerge::FIELDS.each do |field|
            %tr{ data: address_merge_row_data(merge, field) }
              %th= Admin::AddressMergesHelper::FIELD_LABELS.fetch(field)
              - merge.addresses.each do |address|
                %td= address_merge_cell(merge, field, address)
          %tr
            %th Active member
            - merge.addresses.each do |address|
              %td= address_merge_member(address)
          %tr
            %th Donor
            - merge.addresses.each do |address|
              %td= address_merge_donor(address)
          %tr
            %th Orders
            - merge.addresses.each do |address|
              %td= address.orders.count
      %p#merge-summary= address_merge_summary(merge, constituent_id: @constituent_id)
      .button-group
        = link_to 'Cancel', @cancel_path, class: 'button secondary'
        = submit_tag "Merge into ##{merge.master.id}", class: 'button alert'

= content_for :js do
  :javascript
    'use strict';

    // Rebuilds the "comes from" sentence of #merge-summary as
    // Admin::AddressMergesHelper#address_merge_sources_sentence does.
    (function() {
      var form = document.getElementById('address-merge-form');
      var target = document.getElementById('merge-summary-sources');
      var master = String(target.dataset.master);

      function listOf(labels) {
        if (labels.length <= 2) { return labels.join(' and '); }
        return labels.slice(0, -1).join(', ') + ' and ' + labels[labels.length - 1];
      }

      function update() {
        var groups = {};
        var order = [];
        form.querySelectorAll('tr[data-merge-field]').forEach(function(row) {
          var source = row.querySelector('input[type=radio]:checked') || row;
          var customer = source.dataset.customer;
          if (!customer || customer === master) { return; }
          if (!groups[customer]) { groups[customer] = []; order.push(customer); }
          groups[customer].push(source.dataset.label);
        });
        var text = order.map(function(customer) {
          var labels = groups[customer];
          return listOf(labels) + (labels.length === 1 ? ' comes' : ' come') + ' from #' + customer;
        }).join('; ');
        target.textContent = text ? ' ' + text.charAt(0).toUpperCase() + text.slice(1) + '.' : '';
      }

      form.addEventListener('change', function(event) {
        if (event.target.type === 'radio') { update(); }
      });
    })();
