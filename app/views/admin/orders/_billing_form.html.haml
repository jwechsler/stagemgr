-# allowed_payment_types (optional): narrows the list, e.g. to the Exchange's
-# new performance. Otherwise the order's own performance decides
-# (TicketOrder#valid_payment_types_for).
- paytype = payment_types(order_form.object, local_assigns[:allowed_payment_types], false)
.payment_type_choice
  = order_form.association :payment_type, :label=>"Pay using", :include_blank=>false, :as=>:select, :collection=>paytype

#payment_forms
  #credit_card_payment_form
    = render '/admin/orders/credit_card_payment_form', :f => order_form
  #cash_payment_form
    = render '/admin/orders/cash_payment_form', :f => order_form
  #flex_pass_payment_form
    = render '/orders/flex_pass_payment_form', :f => order_form
  #membership_payment_form
    = render '/orders/membership_payment_form', :f => order_form
  #check_payment_form
    = render '/orders/check_payment_form', :f => order_form
