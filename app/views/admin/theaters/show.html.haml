= content_for :breadcrumbs do
  = render "shared/components/breadcrumb", items: [{ label: 'Theaters', path: admin_theaters_path }, { label: @theater.name }]

.grid-x
  .small-10.cell.left
    .grid-x.grid-padding-x
      - if @theater.logo.attached?
        - colsize = 8
        .small-2.medium-2.cell.hide-for-small-only
          = @theater.decorate.logo(Theater::MEDIUM)

      - else
        - colsize = 10

      .small.cell{:class=>"small-#{colsize} medium-#{colsize}"}
        %h3
          = @theater.name
          = render 'admin/tags/pills', tags: @theater.theater_tags
        = link_to(@theater.url, @theater.url) unless @theater.url.blank?



  .small-2.cell.right
    %span.secondary.label= @theater.theater_class
    %span.secondary.label= @theater.status

  - if @theater.donation_appeal.present? || @theater.secondary_donation_appeal.present?
    .cell
      %h4 Donation appeals
      - if @theater.donation_appeal.present?
        %h5 Default appeal
        = display_markdown(@theater.donation_appeal)
      - if @theater.secondary_donation_appeal.present?
        %h5 Secondary appeal
        = display_markdown(@theater.secondary_donation_appeal)

  .cell
    %h4 Productions
    = render :partial => 'production_listing'


  - if can? :create, Production then
    = ui_button 'Add production', [:new, :admin, @theater, :production]
