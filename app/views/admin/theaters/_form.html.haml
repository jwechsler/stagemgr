= simple_form_for([:admin, theater], :html => { :multipart => true }) do |f|
  = token_tag
  = render 'shared/return_to_field'
  .grid-padding-x.grid-x
    .cell.medium-6.small-12
      = f.input :name
    .cell.medium-6
      = f.input :url,  placeholder:"Enter a URL...", label:"link"

    .cell.small-12
      = f.input :logo
    .cell.medium-6.small-12
      = f.input :theater_class, :as => :select, :collection => Theater::THEATER_CLASSES
    .cell.medium-6.small-12
      -# Shows the stored status; only a new theater defaults to Active.
      = f.input :status, as: :select, collection: Theater::THEATER_STATUSES, include_blank: false,
                         selected: theater.status.presence || Theater::ACTIVE
    
    .cell.small-12.medium-6
      .grid-padding-x.grid-x
        .cell.small-12
          = f.input :default_service_items, label:"Default Service Template Names", hint:"Comma-separated list of service items to be applied to each ticket order"
        .cell.small-12
          = f.input :default_first_exchange_items, label:"Exchange Service Template Names", hint:"Comma-separated list of service items to be applied to intial ticket exchange"
        .cell.small-12
          = f.input :default_addl_exchange_items, label:"Additional Exchange Service Template Names", hint:"Comma-separated list of service items to be applied to each subsequent ticket exchange"
    .cell.small-12.medium-6
      .grid-padding-x.grid-x
        .cell.small-12
          = f.input :myemma_attendee_group
        .cell.small-12
          = f.input :accepts_donations, label: "Is 501(c)(3)", as: :boolean
    .cell.small-12
      :ruby
        appeal_hint = "Shown in the donation section of this theater's ticket orders. Markdown enabled. " \
                      "{{theater}} inserts this theater's name. Blank uses the standard wording."
        secondary_hint = 'Used only by the default theater, on orders for resident, visiting and guest ' \
                         'productions (not co-productions). {{company}} inserts that company\'s name. ' \
                         'Blank uses the default appeal.'
      = f.input :donation_appeal, as: :markdown, input_html: { rows: 4 }, label: 'Default appeal', hint: appeal_hint
      = f.input :secondary_donation_appeal, as: :markdown, input_html: { rows: 4 }, label: 'Secondary appeal',
                                            hint: secondary_hint
    .cell.small-12
      %h5 Tags
      = render 'admin/tags/tag_input', f: f, autocomplete_url: autocomplete_tag_admin_theaters_path
    .cell.small-12
      = f.button :submit
