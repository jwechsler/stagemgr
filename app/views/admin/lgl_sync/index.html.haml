= content_for :title do
  Little Green Light sync
= content_for :breadcrumbs do
  - crumbs = [{ label: 'System Options', path: admin_system_options_path }, { label: 'Little Green Light sync' }]
  = render "shared/components/breadcrumb", items: crumbs

:ruby
  source_labels = { env: 'from ENV', server_yml: 'from config/server.yml', none: 'not set' }
  sync_env = Lgl::Settings::SYNC_ENV
  writable_env = Lgl::Settings::WRITABLE_ENV
  mode_labels = { enabled: 'Enabled', readonly: 'Read-only', disabled: 'Disabled' }
  poll_never = 'not yet (starts from the first scheduled poll)'
.grid-x.grid-padding-x
  .small-12.cell
    %fieldset.fieldset
      %legend Status
      - unless @enabled
        %p
          - if @settings.sync_enabled?
            Little Green Light sync is #{@settings.sync_mode} (littlegreenlight.sync) but LGL_API_KEY is missing.
          - else
            Little Green Light sync is disabled (littlegreenlight.sync).
      %table.unstriped
        %tbody
          %tr
            %th Sync
            %td
              = mode_labels.fetch(@settings.sync_mode)
              - if @settings.sync_source == :env
                (#{sync_env})
              - elsif @settings.sync_source == :server_yml
                (littlegreenlight.sync)
          - if @enabled
            %tr
              %th Writes to LGL
              %td
                - if @read_only
                  - if @settings.read_only_mode?
                    Read-only (littlegreenlight.sync)
                  - else
                    Read-only in development
                  - if @writable_address_ids.any?
                    except address ids #{@writable_address_ids.join(', ')}
                - else
                  Enabled
            %tr
              %th Writable address ids
              %td
                - case @settings.writable_address_ids_source
                - when :env
                  #{source_labels[:env]} #{writable_env}
                - when :server_yml
                  #{source_labels[:server_yml]} littlegreenlight.writable_address_ids
                - else
                  = source_labels[:none]
                - if !@read_only && @settings.writable_address_ids_source != :none
                  (ignored unless sync is readonly)
            %tr
              %th Polled LGL changes through
              %td= @last_poll ? @last_poll.to_formatted_s(:short_date_and_time) : poll_never
            %tr
              %th Last sweep finished
              %td= @last_sweep ? @last_sweep.to_formatted_s(:short_date_and_time) : 'never'
            %tr
              %th Linked customers
              %td= number_with_delimiter(@linked_count)
            = render 'gift_history_rows', lapsed_counts: @lapsed_counts, last_walk: @last_gift_history_walk
            = render 'gift_rows', campaign: @campaign, campaigns: @campaigns, campaign_error: @campaign_error,
                                  gift_count: @gift_count, last_gift: @last_gift, choosing: @choosing_campaign
          -# The donor-tier report needs only its link, so these rows show even when the API sync is off.
          = render 'donor_levels_rows', enabled: @donor_levels_enabled, settings: @settings,
                                        recipient: @donor_levels_recipient,
                                        last_fetch: @last_donor_levels_fetch, last_import: @last_donor_levels_import

      = render 'buttons', sync_buttons: @enabled, donor_levels_button: @donor_levels_enabled

    - if @enabled
      %fieldset.fieldset
        %legend LGL Review (#{number_with_delimiter(@review_count)})
        - if @review_tags.empty?
          %p No customers need review.
        - else
          - if @review_count > @review_tags.size
            %p Showing the oldest #{@review_tags.size} of #{number_with_delimiter(@review_count)}.
          %table
            %thead
              %tr
                %th Customer
                %th Reason
                %th Flagged
            %tbody
              - @review_tags.each do |tag|
                %tr
                  %td
                    - if tag.address
                      = lgl_review_customer_link(tag)
                    - else
                      = "##{tag.address_id}"
                  %td= tag.tag_value
                  %td= tag.created_at&.to_formatted_s(:short_date_and_time)
