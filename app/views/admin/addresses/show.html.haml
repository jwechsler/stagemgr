= content_for :title do
  = @address.full_name
= content_for :breadcrumbs do
  = render "shared/components/breadcrumb", items: [{ label: 'Customers', path: admin_addresses_path }, { label: @address.full_name }]

.grid-x.grid-padding-x
  .small-12.medium-6.cell
    = render :partial=>"/admin/addresses/address_contact_info", :locals=>{:address=>@address}
  .small-12.medium-6.cell
    - staff = !current_user.is_theater_user?
    - if staff && @address.is_current_member?
      %fieldset.fieldset
        %legend Active Memberships
        - active = @address.memberships.select(&:active?)
        = safe_join(active.map { |m| link_to(m.member_code, [:admin, m.membership_order || m]) }, ', ')
    - if @address.is_current_flex_pass_holder?
      %fieldset.fieldset
        %legend Active Flex Passes
        - @address.flex_passes.select{|fp| !fp.expired?}.each do |fp|
          = fp.decorate.description
          %br
    
    - if staff && @address.is_donor?
      .donor-tier-labels.text-right
        - if @address.donor_tier_for_last_fiscal_year.present?
          %span.label.warning Previous FY: #{@address.donor_tier_for_last_fiscal_year}
        - if @address.donor_tier_for_current_fiscal_year.present?
          %span.label.success Current FY: #{@address.donor_tier_for_current_fiscal_year}
    = render(:partial=>"/admin/address_tags/tags", :locals=>{:address_tags=>@address.address_tags})
  .small-12.cell.right
    = link_to 'Edit', edit_admin_address_path(@address), :class=>'small button'
- attended_scope = staff ? @address.productions : @address.productions.where(theater_id: current_user.theater_ids)
- productions_attended = attended_scope.order(opening_at: :desc).uniq
%fieldset.fieldset
  %legend
    = "#{pluralize(productions_attended.size,'Production')} Attended"
  %i= productions_attended.map(&:name).join(', ')

- if !@address.orders.nil? && @address.orders.size > 0
  = render :partial=>"/admin/addresses/order_history", :locals=>{address: @address}

