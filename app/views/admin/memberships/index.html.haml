= content_for :title do
  Memberships
= content_for :breadcrumbs do
  = render "shared/components/breadcrumb", items: [{ label: "Memberships" }]

.grid-x.grid-padding-x
  .small-12.cell
    - status_choices = [['', 'All']] + MembershipDatatable::STATUS_PRIORITY.map { |status| [status, status] }
    %table#membership-listing{ data: { source: admin_memberships_path(format: :json), status_choices: status_choices } }
      %thead
        %tr
          %th Member Code
          %th Offer
          %th Member
          %th Status
          %th Start
          %th Membership End
          %th Duration (months)
          %th
      %tbody


= content_for :js do
  :javascript
    $(document).ready(function() {
      var statusFilter = datatableChoiceFilter({
        param: 'status',
        choices: $('#membership-listing').data('status-choices'),
        ariaLabel: 'Filter by status',
        slotClass: 'table-choice-filter'
      });
      var table = $('#membership-listing').DataTable(statusFilter.configure({
        "processing": true,
        "serverSide": true,
        "stateSave": true,
        "ajax": $('#membership-listing').data('source'),
        "pagingType": 'full_numbers',
        "language": {
          "lengthMenu" : "_MENU_ entries"
        },
        columns: [
          {data: 'member_code'},
          {data: 'offer'},
          {data: 'member'},
          {data: 'status'},
          {data: 'start'},
          {data: 'membership_end'},
          {data: 'duration', searchable: false},
          {data: 'actions', orderable: false, searchable: false}
        ],
        order: [[3, 'asc'], [2, 'asc']]
      }));
      statusFilter.attach(table);
    });
