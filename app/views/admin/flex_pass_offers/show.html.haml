- offer = @flex_pass_offer.decorate
= content_for :title do
  Flex Pass Offer
= content_for :breadcrumbs do
  = render 'shared/components/breadcrumb',
           items: [{ label: 'Flex Pass Offers', path: admin_flex_pass_offers_path }, { label: @flex_pass_offer.name }]

= render 'header', offer: offer

.grid-x.grid-padding-x
  .small-12.medium-6.cell
    = render 'patron_terms', offer: offer
    = render 'payout', offer: offer
  .small-12.medium-6.cell
    = render 'redemption_rules', offer: offer
    = render 'availability', offer: offer

- if @flex_pass_offer.description.present?
  .grid-x.grid-padding-x
    .small-12.cell
      %h4 Description
      = display_markdown @flex_pass_offer.description

= render 'usage_summary', offer: offer, usage: @usage
= render 'passes', offer: offer

.grid-x.grid-padding-x
  .small-12.cell
    = offer.show_actions
