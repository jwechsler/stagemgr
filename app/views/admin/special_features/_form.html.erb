<%= simple_form_for [:admin, @special_feature] do |f| %>
  <%= token_tag %>
  <div class="grid-x grid-padding-x">
    <div class="small-6 cell">
      <%= f.input :short_name, :hint=>'Quick selection label' %>
      <%= f.input :status, :as=>:select, :collection=>SpecialFeature::SPECIAL_FEATURE_STATUSES, :include_blank=>false %>
    </div><div class="small-6 cell">
      <%= f.input :description, :input_html=>{:rows=>4}, :hint=>'Markdown enabled display of special feature for web site / emails' %>
      <%= f.input :email_description, :as=>:text, :label=>'Custom Email', :input_html=>{:rows=>4}, :hint=>'Custom text to override the description in emails, markdown enabled' %>
    </div>
    <%= f.button :submit %>
  </div>
<% end %>
