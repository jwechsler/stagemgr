.grid-x.grid-padding-x
  .small-12.cell
    %fieldset.fieldset
      %legend Order to refund
      %div
        = render :partial=>"/admin/#{@original_order.class.to_s.underscore.pluralize}/full_order", :locals=>{:order=>@original_order}

    = render :partial=>'/error_messages', locals: {object: @original_order}

    - if @refund_blockers.any?
      %h3 Can't refund this order.
      %ul#refund-blockers
        - @refund_blockers.each do |blocker|
          %li= blocker
    - else
      - if @exchange_chain.size > 1
        %h4 This order ends an exchange chain. Refunding settles every order in it:
      - else
        %h4 Refunding returns each payment on its own tender:
      - @exchange_chain.each do |order|
        - if @exchange_chain.size > 1
          %h5.refund-plan-order{ id: "refund-plan-order-#{order.id}" }
            = link_to "Order ##{order.id}", admin_order_path(order)
            = "(#{order.status})"
        %ul.refund-plan{ id: ('refund-plan' if order == @original_order) }
          - order.payments.each do |payment|
            %li= refund_plan_line(payment, tenders: @refund_tenders, reversals: @refund_reversals)
      = form_for [:admin,@original_order,@refund_order], :url=>admin_order_refund_orders_path(@original_order) do |order_form|
        %p
          = order_form.label :notes
          = order_form.text_field :notes
        %p
          = order_form.submit refund_button_label(@original_order), :disable_with => 'Processing...', :class=>'alert button'
