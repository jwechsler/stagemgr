.grid-x.grid-padding-x
  .small-12.cell
    %fieldset.fieldset
      %legend Order to refund
      %div
        = render :partial=>"/admin/#{@original_order.class.to_s.underscore.pluralize}/full_order", :locals=>{:order=>@original_order}

    = render :partial=>'/error_messages', locals: {object: @original_order}

    - unsupported = unsupported_refund_payments(@original_order)
    - if @original_order.try(:paid_by_exchange?)
      %h3 This order was paid with exchange credit, so it can't be refunded here.
      %p Use Exchange Order and choose a refund to return money on an exchanged order.
    - elsif !@original_order.refundable?
      %h3 This order can't be refunded, as it hasn't been processed.
    - elsif unsupported.any?
      %h3 Can't refund this order.
      %p= "Refunds don't handle #{unsupported.map(&:display_name).uniq.to_sentence} payments."
    - else
      %h4 Refunding returns each payment on its own tender:
      %ul#refund-plan
        - @original_order.payments.each do |payment|
          %li= refund_plan_line(payment)
      = form_for [:admin,@original_order,@refund_order], :url=>admin_order_refund_orders_path(@original_order) do |order_form|
        %p
          = order_form.label :notes
          = order_form.text_field :notes
        %p
          = order_form.submit refund_button_label(@original_order), :disable_with => 'Processing...', :class=>'alert button'
