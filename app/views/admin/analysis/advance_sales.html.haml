= content_for :title do
  Advance Sales Analysis
= content_for :breadcrumbs do
  - crumbs = [{ label: 'Analysis', path: rate_of_sales_admin_analysis_index_path }, { label: 'Advance Sales' }]
  = render "shared/components/breadcrumb", items: crumbs

= render 'analysis_tabs', active: :advance_sales

.grid-x.grid-padding-x
  .small-12.cell
    %h4 Advance Sales Analysis
    %p.help-text
      How far ahead of each performance its tickets were bought. Counts paid, seat-holding tickets on
      sold orders, dated from the original purchase (exchanges and splits keep the first order's date).
      Comps, and theaters flagged "sales recorded externally", are left out.
      Passes are flex passes whose offer is tied to a theater or festival; building-wide flex passes and
      memberships count as single tickets.

= render 'advance_sales_form', filters: @filters, theaters: @theaters, seasons: @seasons,
                               single_theater: @single_theater

#advance-sales-results
  - if @results.nil?
    -# Nothing run yet, or the filters were invalid.
  - elsif !@results.activity?
    = render "shared/components/callout", variant: "secondary" do
      Nothing sold for that selection.
  - else
    - if @results.truncated
      = render "shared/components/callout", variant: "warning" do
        Showing the first #{AdvanceSalesAnalysis::MAX_SERIES} series; narrow the selection to see the rest.
    = render 'advance_sales_results', results: @results
    = render 'advance_sales_productions', productions: @results.productions

-#
  Results describe the filters they were run with, so any change removes
  them until the next Run.
:javascript
  $(function() {
    $('#advance-sales-form').on('change', function() {
      $('#advance-sales-results').empty();
    });
  });
