-#
  Current show plus the comparison shows it is measured against.
  Locals: target (Production or nil), comparisons (Array<Production>).
= form_tag(rate_of_sales_admin_analysis_index_path, method: :get, id: 'rate-of-sales-form',
                                                    data: { target_production_id: target&.id,
                                                            comparison_production_ids: comparisons.map(&:id),
                                                            search_url: search_admin_productions_path,
                                                            resolve_url: resolve_group_admin_productions_path }) do
  -# Marks a real submission; a target-only link just pre-fills the form.
  = hidden_field_tag 'comparison_production_ids[]', '', id: nil
  .grid-x.grid-padding-x
    .small-12.medium-6.cell
      %fieldset.fieldset
        %legend Current show
        %p.help-text Select the show you want to analyze
        = render 'shared/components/production_picker',
                 field_name: 'target_production_id',
                 scope: :analysis,
                 selected: target,
                 required: true,
                 exclude_field: '#comparison-productions-table input[type=hidden]'

  .grid-x.grid-padding-x
    .small-12.cell
      %fieldset.fieldset
        %legend Comparison shows
        %p.help-text Select shows to aggregate for historical comparison
        .grid-x.grid-margin-x
          .cell.auto
            = text_field_tag :comparison_production_search, nil, id: 'comparison-production-search', name: nil,
                                                                 placeholder: 'Type to search productions...',
                                                                 class: 'input-group-field', autocomplete: 'off'
          .cell.shrink
            %a.button.alert.small#remove-all-comparisons{ href: '#', class: ('hide' if comparisons.empty?) } Remove all

        %table.hover#comparison-productions-table
          %thead
            %tr
              %th Season
              %th Production
              %th Theater
              %th
          %tbody
            - comparisons.each do |p|
              %tr{ data: { production_id: p.id } }
                %td= p.season
                %td= p.name
                %td= p.theater.name
                %td
                  %a.remove-comparison.alert{ href: '#' } remove
                  %input{ type: 'hidden', name: 'comparison_production_ids[]', value: p.id }

  .grid-x.grid-padding-x
    .small-12.cell
      = submit_tag 'Run analysis', class: 'button', name: nil, id: 'run-analysis-btn',
                                   disabled: target.nil? || comparisons.empty?

= render 'rate_of_sales_form_script'
