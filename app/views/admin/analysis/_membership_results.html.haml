.grid-x.grid-padding-x
  .small-12.cell
    - if results.idle_offers.any?
      %p.help-text
        No activity in this range, so not shown:
        = results.idle_offers.map(&:name).to_sentence
    - if results.by_offer.any?
      = render 'membership_tables', rows: [results.total] + results.by_offer
    - if results.pass_offers.any?
      = render 'membership_passes', results: results
