- content_for :title do
  = @production.name
- content_for :breadcrumbs do
  = render "shared/components/breadcrumb", items: [{ label: 'Theaters', path: admin_theaters_path }, { label: @production.theater.name, path: admin_theater_path(@production.theater) }, { label: @production.name, path: admin_theater_production_path(@production.theater, @production) }, { label: @performance.performance_code }]

.grid-x.grid-padding-x
  .small-12.cell
    %h3
      %i= @performance.production.name
      on
      = @performance.performance_date
      at
      = @performance.performance_time.to_s(:hour_min)

    Performance Code:
    = @performance.performance_code
    %br
    Status:
    = @performance.status
    %br
    = render partial: 'admin/performances/special_features', locals: { performance: @performance }


    %h3 Available ticket classes
    %fieldset.fieldset
      %legend On Sale to Public
      - allocations = @performance.ticket_class_allocations.select { |tca| tca.available? && tca.ticket_class.web_visible? }.sort{|a,b| a.ticket_class.class_code <=> b.ticket_class.class_code }
      = render partial: 'ticket_class_allocations', locals: {allocations: allocations}
    %fieldset.fieldset
      %legend Backend
      - allocations = @performance.ticket_class_allocations.select{|tca| tca.available? && !tca.ticket_class.web_visible? }.sort{ |a,b| a.ticket_class.class_code <=> b.ticket_class.class_code }
      = render partial: 'ticket_class_allocations', locals: {allocations: allocations}

