- festival_blocks = @festival_blocks || []
- unless @now_playing_productions.empty? && @offtime_productions.empty? && festival_blocks.empty?
  #now_playing_shows_by_venue.production_list.grid-x.grid-padding-x
    - num_pieces = (@now_playing_productions.size + festival_blocks.size + (@offtime_productions.empty? ? 0 : 1))
    - row_count = (num_pieces > @max_pieces) ? @max_pieces : num_pieces
    - slice = 100 / [row_count, 1].max
    - @now_playing_productions.each do |venue_production|
      - if row_count == 0 then
        - num_pieces -= @max_pieces
        - row_count = (num_pieces > @max_pieces) ? @max_pieces : num_pieces
        - slice = 100 / row_count
        %br{:style=>"clear: both"}
      = render :partial=>"show_thumb", :locals=>{:slice=>slice,:production=>venue_production, :background=>@background}
      - row_count -= 1
    -# Non-primetime shows share one tile, sized and headed like a venue thumb
    -# (_show_thumb) but with no promo image — just name, short description and
    -# presenter, one show per block.
    - if !@offtime_productions.empty?
      %div{:class=>"show-listing background-#{@background} cell small-12 medium-#{(slice * 12.0 / 100).round}"}
        %p
          %div.venue Plus
          %br
          - @offtime_productions.each_with_index do |production, index|
            - if index.positive?
              %br
            %div.production_name
              = link_to production.name, production_performances_path(production.id, :anchor=>"top")
            - unless production.short_description.blank?
              = production.short_description
            - if !production.theater.is_default?
              %div.presenter= "presented by #{production.theater.name}"
    - festival_blocks.each do |block|
      = render :partial=>"venues/festival_block", :locals=>{:block=>block, :background=>@background, :slice=>slice}
