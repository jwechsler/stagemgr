- order_class_zones = order_uuid.present? ? TicketClass.where(id: SeatAssignment.where(order_uuid: order_uuid).select(:ticket_class_id)).distinct.pluck(:zone_id) : []
-# The admin box-office page requests backend (non-web-visible) classes in the
-# ticket_classes JSON; PerformancesController honors the param only for users
-# with the view_backend_classes ability, so it is a context hint, not a hole.
- show_backend_classes = local_assigns.fetch(:show_backend_classes, false)
- ticket_classes_params = { format: :json }.merge(show_backend_classes ? { include_backend: '1' } : {})
