<%# The page a donor lands on after giving. Deliberately short and plain: a
    house with something warmer to say overrides this whole file in its theme
    (sites/theaterwit/views/donation_orders/show.html.erb is the worked
    example). See sites/README.md. %>
<div class="grid-x grid-padding-x">
  <div class="small-12 cell">
    <p>
      Thank you! We have charged your credit card
      <%= number_to_currency(@order.total_paid) %> today for your donation, and we will send
      you a receipt by email for your tax records.
      <% if theater_info.phone.present? %>
        Please don't hesitate to call us at <%= theater_info.phone %> if you have any questions.
      <% end %>
    </p>
    <p>
      Thanks again, <br/>
      <%= render 'order_mailer/signature' %>
    </p>
  </div>
</div>
