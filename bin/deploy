#!/bin/bash
# Deploy stagemgr on the production box (bare-metal Passenger, from a flat
# git checkout wherever it lives).
#
# Runs the manual deploy sequence in a fixed order so no step can be
# forgotten:
#   git pull -> gems -> yarn -> migrate -> doctor -> precompile -> restart -> smoke check
#
# Every step is idempotent, so a failed deploy is retried by simply running
# the script again. The smoke check doubles as the request that boots the
# new code under Passenger, so a boot crash (e.g. a missing gem) fails the
# deploy here instead of surfacing to the first customer.
#
# Usage, from the dev machine:
#   ssh deploy@theaterwit.org 'RAILS_ENV=production /var/www/stagemgr/bin/deploy'
# (non-interactive ssh may not source the deploy user's profile, so pass
# RAILS_ENV on the command line).

set -euo pipefail

# Refuse to run unless the caller already set RAILS_ENV=production -- a
# development checkout must never receive production rake tasks.
if [[ "${RAILS_ENV:-}" != "production" ]]; then
  echo "Refusing to deploy: RAILS_ENV is '${RAILS_ENV:-unset}', not 'production'. Export RAILS_ENV=production on the production box (e.g. in the deploy user's profile) before running bin/deploy." >&2
  exit 1
fi
export RAILS_ENV

APP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SMOKE_URL="${SMOKE_URL:-https://www.theaterwit.org/tickets/login}"
LOG_FILE="$APP_ROOT/log/deploys.log"

cd "$APP_ROOT"
started_at=$(date +%s)

step() { printf '\n==> %s\n' "$*"; }

step "Pulling master"
old_sha=$(git rev-parse --short HEAD)
git checkout master
git pull --ff-only
new_sha=$(git rev-parse --short HEAD)
echo "    ${old_sha} -> ${new_sha}"

step "Gems"
bundle check || bundle install

step "JS packages"
yarn install --frozen-lockfile

step "Database migrations"
bundle exec rails db:migrate

# Fails the deploy BEFORE Passenger restarts if a required secret or a
# config file is missing (RequiredSecrets would otherwise refuse the boot
# and the smoke check below would be the first to notice, after the old
# workers are already gone). Prints sources only, never values.
step "Health check (rake setup:doctor)"
bundle exec rake setup:doctor

step "Assets"
bundle exec rails assets:precompile

step "Restarting Passenger"
touch tmp/restart.txt

step "Restarting Resque workers"
script/resque-worker restart

# Both restarts wait for the old processes to exit (escalating to KILL) before
# starting new ones, and the scheduler stop also sweeps a scheduler that lost
# its pidfile -- see script/process-helpers.sh. A worker or scheduler that
# cannot be stopped fails the deploy here rather than leaving two copies
# running old code.
step "Restarting Resque scheduler"
script/scheduler restart

step "Smoke check (${SMOKE_URL})"
curl -fsS --max-time 120 -o /dev/null "$SMOKE_URL"
echo "    OK"

printf '%s deploy %s -> %s (%ss)\n' \
  "$(date '+%Y-%m-%d %H:%M:%S')" "$old_sha" "$new_sha" "$(($(date +%s) - started_at))" >> "$LOG_FILE"
step "Deployed ${new_sha}"
