# Stagemgr environment configuration.
#
#   cp .env.example .env      (or: bundle exec rake setup:config)
#
# .env is gitignored. Both `docker compose` and dotenv-rails read it from the
# project root; dotenv-rails is loaded in the development and test groups only,
# so in production the same variables must come from the process environment
# (Compose `environment:`, Passenger `SetEnv`, systemd `EnvironmentFile`, ...).
#
# ── How secrets resolve ────────────────────────────────────────────────────
# Every secret below is read through AppSecrets, which checks, in order:
#
#   1. the environment variable — but only if it is NON-BLANK
#   2. Rails encrypted credentials (config/credentials/<env>.yml.enc)
#   3. config/server.yml — DEPRECATED, and only for resque_admin_password.
#      Reading a secret from there warns at boot; move it up a layer.
#
# A variable set to the empty string does NOT shadow a credential; it is
# skipped. That is deliberate (a blank POSTMARK_API_TOKEN once took down
# transactional email), but a blank line is still noise: if you are not using
# a key, DELETE the line rather than leaving `KEY=`.
#
# Non-secret settings (database host, ports, feature switches) are plain
# environment variables with no credentials fallback.
#
# ── Which mechanism should I use? ──────────────────────────────────────────
# .env is the easy path for development and for Docker deployments. Encrypted
# credentials are the better fit for a bare-metal install where the process
# environment is awkward to populate. See
# docs/manual/developer/credentials.md.

# ═════════════════════════════════════════════════════════════════════════
# Database
# ═════════════════════════════════════════════════════════════════════════
# Defaults target a native install talking to MySQL on the host.
# docker compose overrides DATABASE_HOST to the `mysql` service name.
#
# DATABASE_USER must NOT be `root`: the mysql image refuses to start with
# MYSQL_USER=root. Note also that the image bakes these credentials into its
# data volume the first time it initializes — changing them later has no effect
# until you `docker compose down -v` or ALTER USER by hand.
DATABASE_USER=stagemgr_dev
DATABASE_PASSWORD=password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=stagemgr_dev
# Test and Cucumber suites. Give every concurrent checkout its own database:
# the suites truncate every table between examples.
TEST_DATABASE_NAME=stagemgr_test
# ActiveRecord connection pool size. Raise only if you also raise the thread or
# worker count.
# DATABASE_POOL=5
# Unix socket instead of TCP (handy for a native macOS Homebrew MySQL).
# Leave blank to connect over DATABASE_HOST/DATABASE_PORT.
# DATABASE_SOCKET=/tmp/mysql.sock

# docker compose only: the MySQL container's root password. Deliberately not the
# same as DATABASE_PASSWORD — the application never uses root.
# MYSQL_ROOT_PASSWORD=changeme-root

# ═════════════════════════════════════════════════════════════════════════
# Redis (Resque queues, Rack::Attack throttling)
# ═════════════════════════════════════════════════════════════════════════
# docker compose overrides this to redis://redis:6379/0.
REDIS_URL=redis://127.0.0.1:6379/0

# ═════════════════════════════════════════════════════════════════════════
# Rails
# ═════════════════════════════════════════════════════════════════════════
RAILS_ENV=development

# Session/cookie signing key. Generate one with `bundle exec rails secret`,
# or let `bundle exec rake setup:secret_key_base` fill it in.
SECRET_KEY_BASE=

# Alternative to SECRET_KEY_BASE and the other secrets below: ship
# config/credentials/production.yml.enc and supply only its key here. Do not
# commit the key. (config/master.key on disk does the same job.)
# RAILS_MASTER_KEY=

# Sub-path the app is mounted at, when it is not served from /. Must agree with
# server.yml's `sub_uri`. Compose passes it through as RAILS_RELATIVE_URL_ROOT
# and the Foundation-mode Nginx config serves /tickets.
# STAGEMGR_SUB_URI=/tickets

# ═════════════════════════════════════════════════════════════════════════
# Payment processing
# ═════════════════════════════════════════════════════════════════════════
# Stripe test keys begin sk_test_; live keys sk_live_. The webhook signing
# secret begins whsec_ and is only needed if you receive Stripe webhooks.
STRIPE_SECRET_KEY=
STRIPE_SIGNING_SECRET=

# Legacy PayPal. Only read when server.yml's payment_processing.default_gateway
# (or default_recurring_gateway) is paypal / paypal_express. Stripe is the
# current default; leave these out unless you need them.
# PAYPAL_LOGIN=
# PAYPAL_PASSWORD=
# PAYPAL_SIGNATURE=
# PAYPAL_PEM_FILE=
# PAYPAL_EXPRESS_LOGIN=
# PAYPAL_EXPRESS_PASSWORD=

# ═════════════════════════════════════════════════════════════════════════
# Email
# ═════════════════════════════════════════════════════════════════════════
# Required when server.yml sets email.delivery_method: postmark. The from- and
# to-addresses themselves live in server.yml under email.addresses.
POSTMARK_API_TOKEN=

# ═════════════════════════════════════════════════════════════════════════
# Optional integrations
# ═════════════════════════════════════════════════════════════════════════
# MyEmma mailing list. All three are required together; if any is blank the
# integration disables itself and the code paths short-circuit. Development
# always runs MyEmma read-only: reads work, writes are logged and skipped.
# MY_EMMA_USERNAME=
# MY_EMMA_PASSWORD=
# MY_EMMA_ACCOUNT_ID=

# ActiveStorage on S3 — uncomment the matching block in config/storage.yml.
# Blank means local disk storage.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# HTTP basic-auth password for the mounted Resque web UI (/admin/resque).
# Supersedes server.yml's deprecated resque_admin_password key.
RESQUE_ADMIN_PASSWORD=

# ═════════════════════════════════════════════════════════════════════════
# setup:wizard
# ═════════════════════════════════════════════════════════════════════════
# When set, `rake setup:admin` (and the full wizard) skip the interactive
# prompt and use these instead. Handy for scripted/CI installs.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# ═════════════════════════════════════════════════════════════════════════
# docker compose
# ═════════════════════════════════════════════════════════════════════════
# Host-side port publishing. Override to run a second stack alongside one that
# already owns the defaults. Ports bind to loopback; set STAGEMGR_BIND=0.0.0.0
# only if you deliberately want the dev stack reachable from the network.
# STAGEMGR_PORT=8080
# STAGEMGR_BIND=127.0.0.1
# MYSQL_PORT=3306
# REDIS_PORT=6379

# Linux hosts only. The image's `app` user is uid 9999, so files the container
# writes into the bind mount (log/, tmp/, public/packs) come back owned by a
# stranger. Set these to `id -u` and `id -g` and the entrypoint renumbers `app`
# to match. Unnecessary on Docker Desktop (macOS/Windows), which maps ownership
# in its VM.
# HOST_UID=1000
# HOST_GID=1000

# Prepare the database on container start (accepts true/1/yes, any case).
# Defaults to true in development and false in production, where schema changes
# belong to a deploy step rather than to a container restart.
# DB_PREPARE_ON_BOOT=true

# Queues the containerized Resque worker consumes. "*" is every queue.
# RESQUE_QUEUES=*

# ═════════════════════════════════════════════════════════════════════════
# Production tuning and escape hatches
# ═════════════════════════════════════════════════════════════════════════
# RAILS_SERVE_STATIC_FILES=true   # serve public/ from Rails instead of Nginx/Apache
# RAILS_LOG_TO_STDOUT=true        # log to stdout for the Docker/journald log driver

# Puma only (the Docker image runs Passenger).
# RAILS_MAX_THREADS=5
# WEB_CONCURRENCY=2
# PORT=3000

# Let the production boot check pass with secrets missing. Only for a build or
# maintenance process that never serves a request.
# SKIP_REQUIRED_SECRETS_CHECK=1

# Debugging aids.
# RAILS_RAISE_ERRORS=1            # re-raise controller errors instead of rescuing
# BACKTRACE=1                     # unsilenced backtraces
