#!/bin/bash
# Start, stop, check or restart the Resque workers. Inherits RAILS_ENV from the
# caller (bin/deploy exports production), defaulting to development.
#
# Production runs three workers split by queue, each with its own pidfile and
# log; every other environment runs a single worker for all queues. stop waits
# for each worker to exit before returning (see script/process-helpers.sh), so
# restart never overlaps old and new workers.

APP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$APP_ROOT" || exit 1
. "$APP_ROOT/script/process-helpers.sh"

export RAILS_ENV="${RAILS_ENV:-development}"
# Matches a worker while it is still booting (rake command line) and once
# Resque has rewritten its procline to "resque-X.Y.Z: Waiting for ...".
PATTERN="^resque-[0-9.]+: |rake environment resque:work"
FAILED=0

# for_each_worker FUNCTION -- calls FUNCTION LABEL PIDFILE QUEUES LOGFILE
for_each_worker() {
  if [ "$RAILS_ENV" = "production" ]; then
    "$1" "Resque worker #1" resque.pid "notification,report,import,sync" log/resque.log
    "$1" "Resque worker #2 (printing)" resque-printing.pid "printing,batch_printing" log/printing_queue.log
    "$1" "Resque worker #3 (maintenance)" resque-maint.pid "default,maintenance" log/maintenance_queue.log
  else
    "$1" "Resque worker" resque.pid "*" log/resque.log
  fi
}

start_worker() {
  local label="$1" pidfile="$APP_ROOT/$2" queues="$3" logfile="$4"
  if status_pidfile_process "$label" "$pidfile" >/dev/null; then
    echo "$label is already running with PID $(cat "$pidfile"); use restart" >&2
    FAILED=1
    return
  fi
  nohup bundle exec rake environment resque:work PIDFILE="$pidfile" QUEUE="$queues" >> "$logfile" 2>&1 &
  echo $! > "$pidfile"
  echo "Started $label for $queues queues with PID $(cat "$pidfile")"
}

stop_worker() {
  stop_pidfile_process "$1" "$APP_ROOT/$2" "$PATTERN" || FAILED=1
}

status_worker() {
  status_pidfile_process "$1" "$APP_ROOT/$2" || FAILED=1
}

case "$1" in
  start)
    echo "Starting $RAILS_ENV Resque workers..."
    for_each_worker start_worker
    ;;
  stop)
    for_each_worker stop_worker
    ;;
  status)
    for_each_worker status_worker
    ;;
  restart)
    for_each_worker stop_worker
    if [ "$FAILED" -ne 0 ]; then
      echo "Not starting new workers while an old one is still running" >&2
      exit 1
    fi
    echo "Starting $RAILS_ENV Resque workers..."
    for_each_worker start_worker
    ;;
  *)
    echo "Usage: $0 {start|stop|status|restart}"
    exit 1
    ;;
esac
exit "$FAILED"
