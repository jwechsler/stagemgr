#!/bin/bash

#!/bin/bash

case "$1" in
  start)
    # Both branches were identical; the scheduler simply inherits whatever
    # RAILS_ENV the caller exported (production passes its own), defaulting to
    # development when nothing is set.
    RAILS_ENV="${RAILS_ENV:-development}" nohup bundle exec rake environment resque:scheduler PIDFILE=./resque-scheduler.pid QUEUE="*" >> log/resque-scheduler.log 2>&1 &
    ;;
  stop)
    if [ -f ./resque-scheduler.pid ]; then
      kill $(cat ./resque-scheduler.pid)
      if [ $? -eq 0 ]; then
        rm ./resque-scheduler.pid
        echo "Schedule worker stopped"
      else
        echo "Could not stop schedule worker"
      fi
    else
      echo "No schedule worker PID file found"
    fi
    ;;
esac


