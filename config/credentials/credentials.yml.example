# REFERENCE ONLY -- a list of the credential keys this app understands. Do NOT
# copy this file into config/credentials/: credentials are encrypted, and a
# plaintext .yml sitting there is both ignored by Rails and a liability.
#
# To create or edit the real (encrypted) file, run:
#
#   bin/rails credentials:edit --environment development
#   bin/rails credentials:edit --environment production
#
# That writes config/credentials/<env>.yml.enc and, on first run, its
# config/credentials/<env>.key -- keep the .key out of git and give it to the
# server as a file or as RAILS_MASTER_KEY. (An installation that instead uses
# the shared config/credentials.yml.enc + config/master.key pair, as Theater
# Wit's production box does, edits it with `bin/rails credentials:edit`.)
# Paste the keys you need from the list below into that editor session.
#
# Every key below can also be supplied as an environment variable, which wins
# when it is non-blank (see lib/app_secrets.rb for the full registry). A blank
# `KEY=` line in .env is ignored -- but delete it rather than leaving it empty.

postmark_api_token: YOUR-POSTMARK-API-HERE
stripe:
  secret_key: YOUR-STRIPE-API-SECRETKEY
  signing_secret: YOUR-STRIPE-API-SIGNINGSECRET

# Basic-auth password for the Resque dashboard at /admin/resque.
# (ENV: RESQUE_ADMIN_PASSWORD. Previously plaintext in config/server.yml.)
resque_admin_password: YOUR-RESQUE-ADMIN-PASSWORD

#if you are using MyEmma (email list management)
#my_emma:
#  username: API_PUBLIC_KEY
#  password: API_PASSWORD
#  account_id: 99999999

# Set a secret_key_base for persistent sessions across restarts. Required in
# production: without it (or ENV['SECRET_KEY_BASE'], or config/secrets.yml) the
# boot check in lib/required_secrets.rb refuses to start the app.
# Generate one with `bin/rails secret`.
#secret_key_base: GENERATED-64-BYTE-HEX
