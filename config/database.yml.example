# Copy to config/database.yml (`rake setup:config` does this) — the real file is
# gitignored. Every value is environment-driven, so the same generated file
# works for a native install, the Docker stack (which sets DATABASE_HOST=mysql)
# and CI (which points at its ephemeral MySQL service).
#
# MySQL 8 only. utf8mb4/utf8mb4_0900_ai_ci is required: the schema stores emoji
# and other 4-byte characters. See docs/runbooks/utf8mb4-migration.md.
#
# Set DATABASE_SOCKET to connect over a Unix socket instead of TCP — handy for a
# native macOS Homebrew MySQL. Left blank, mysql2 uses host/port.

default: &default
  adapter: mysql2
  encoding: utf8mb4
  collation: utf8mb4_0900_ai_ci
  pool: <%= ENV.fetch("DATABASE_POOL", 5) %>
  username: <%= ENV.fetch("DATABASE_USER", "stagemgr_dev") %>
  password: <%= ENV.fetch("DATABASE_PASSWORD", "password") %>
  host: <%= ENV.fetch("DATABASE_HOST", "127.0.0.1") %>
  port: <%= ENV.fetch("DATABASE_PORT", 3306) %>
  database: <%= ENV.fetch("DATABASE_NAME", "stagemgr_dev") %>
<% if ENV["DATABASE_SOCKET"].to_s.strip != "" %>
  socket: <%= ENV["DATABASE_SOCKET"] %>
<% end %>

development:
  <<: *default

# Warning: the test database is truncated between examples. Never point it at
# development or production. Give each concurrent checkout its own name via
# TEST_DATABASE_NAME.
test: &TEST
  <<: *default
  database: <%= ENV.fetch("TEST_DATABASE_NAME", "stagemgr_test") %>

cucumber:
  <<: *TEST

# No defaults here on purpose: booting production against `stagemgr_dev` with
# the password "password" because a variable was unset is exactly the accident
# worth failing loudly on. ENV.fetch raises KeyError naming the missing key.
production:
  <<: *default
  username: <%= ENV.fetch("DATABASE_USER") %>
  password: <%= ENV.fetch("DATABASE_PASSWORD") %>
  database: <%= ENV.fetch("DATABASE_NAME", "stagemgr_production") %>
