#!/bin/bash
# runit service: the Resque scheduler (enqueues config/schedule.yml jobs).
#
# See docker/service/resque-worker/run for why this is a supervised foreground
# process, why /etc/container_environment.sh has to be sourced as root, and why
# RVM must be sourced inside the app user's own shell.
set -e

source /etc/container_environment.sh 2>/dev/null || true

export RAILS_ENV="${PASSENGER_APP_ENV:-${RAILS_ENV:-development}}"

exec /sbin/setuser app bash -c "
  cd /var/www/stagemgr &&
  source /etc/profile.d/rvm.sh &&
  rvm use 3.2.2@stagemgr &&
  exec bundle exec rake environment resque:scheduler
"
